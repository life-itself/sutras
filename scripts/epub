#!/usr/bin/env python3
"""Build the EPUB of one edition, or of every published edition, with Pandoc.

Usage: scripts/epub <slug>     (run from anywhere; writes downloads/<slug>.epub)
       scripts/epub --all      (every edition whose frontmatter has status: published)

Reads <slug>.md, the same file the site publishes, and makes the small changes an e-reader needs:
the page wrapper and header (raw HTML for the web layout) are dropped; verse (<div class="rs-verse">)
and prose (<div class="rs-passages">) become Pandoc fenced divs; passage numbers become spans with
ids s3, s4.3, and linkable headings (<h3 id="17"><a href="#17">XVII</a></h3>) become headings with
id s17; links to a passage of the same edition (#3 or /slug#3) point at it inside the book; other site
links become full URLs; and the Download section is replaced by a line saying where the text lives
online, naming the passage unit (frontmatter `passageUnit`, else "stanza" for verse, "passage").

Metadata comes from the frontmatter: title, author (creator, without the dates and notes in brackets),
translator (contributor, role trl), licence (rights), source, tradition (subject). The identifier is a
UUID made from the site address, so it never changes. The date and the zip timestamps come from the
source's last commit, not the clock, so an unchanged source gives an unchanged EPUB.

The text is split into one file per chapter: at the level-3 headings if the text has any (Dhammapada,
Seneca, Mumonkan), otherwise at level 2 (Meditations books, Diamond, Faith in Mind). The cover is a
typographic SVG made from the title and author. The stylesheet is scripts/epub.css. If epubcheck is on
the PATH, every EPUB is checked and the build fails on errors.

The output is committed, because Flowershow has no build step; .github/workflows/epub.yml rebuilds it
on every push that changes an edition.
"""
import datetime, html, os, pathlib, re, subprocess, sys, tempfile, textwrap, time, uuid, zipfile
from xml.sax.saxutils import escape

import yaml

ROOT = pathlib.Path(__file__).resolve().parent.parent
SITE = "https://sutras.lifeitself.org"
CSS = ROOT / "scripts" / "epub.css"
PAGES = {"README.md", "about.md", "notes-demo.md", "AGENTS.md", "CLAUDE.md"}


def read_edition(slug):
    text = (ROOT / (slug + ".md")).read_text(encoding="utf-8")
    m = re.match(r"---\n(.*?)\n---\n", text, re.S)
    return yaml.safe_load(m.group(1)), text[m.end():]


def published_slugs():
    slugs = []
    for path in sorted(ROOT.glob("*.md")):
        if path.name in PAGES:
            continue
        m = re.match(r"---\n(.*?)\n---\n", path.read_text(encoding="utf-8"), re.S)
        if m and yaml.safe_load(m.group(1)).get("status") == "published":
            slugs.append(path.stem)
    return slugs


def source_time(slug):
    """The last commit that changed the source, as a Unix time (the clock if it is not committed yet)."""
    out = subprocess.run(["git", "log", "-1", "--format=%ct", "--", slug + ".md"], cwd=ROOT,
                         capture_output=True, text=True).stdout.strip()
    if not out:
        print("warning: %s.md is not committed; using today's date" % slug, file=sys.stderr)
        return int(time.time())
    return int(out)


def person(text):
    """A name for the metadata: 'Wumen Huikai (Mumon Ekai, 1183–1260)' is 'Wumen Huikai'."""
    return re.split(r"\s*\(", text)[0].strip()


def chapter_level(body):
    """Level-3 headings split the text into chapters if it has any; otherwise level 2."""
    text = re.split(r"(?m)^## (?:About this translation|Source and licence|Download)", body, maxsplit=1)[0]
    return 3 if re.search(r"(?m)^### |^<h3\b", text) else 2


def containers(body):
    """Turn the passage containers into Pandoc fenced divs and drop the web layout's wrapper lines."""
    out, stack = [], []
    for line in body.split("\n"):
        m = re.match(r'^<div class="(?:[\w-]+ )*rs-(verse|passages|gatha)">$', line)
        if m:
            stack.append(m.group(1)); out.append("::: " + m.group(1)); continue
        if line == "</div>" and stack and stack[-1] != "drop":
            stack.pop(); out.append(":::"); continue
        if re.match(r"^</?(div|article)\b", line):
            for closing in re.findall(r"<(/?)(?:div|article)\b", line):
                if not closing:
                    stack.append("drop")
                elif stack:
                    stack.pop()
            continue
        out.append(line)
    return "\n".join(out)


def to_book(slug, meta, body):
    """The source's Markdown, with the web layout taken out and EPUB links and containers in."""
    # web-only header
    body = re.sub(r"(?s)<header class=\"rs-head\">.*?</header>\n", "", body)
    body = re.sub(r"(?s)<nav class=\"rs-rail\".*?</nav>\n?", "", body)  # web contents rail; the book has its own
    # the image above the title becomes the frontispiece: a Markdown figure, so Pandoc packages the file
    # (assets/images/<slug>.jpg); frontispiece() then moves it onto the title page
    body = re.sub(r'(?m)^<figure class="sd-art"><img src="/([^"]+)"[^>]*><figcaption>(.*?)</figcaption></figure>$',
                  lambda m: "\n![%s](%s){.frontispiece}\n" % (re.sub(r"</?i>", "*", m.group(2)), m.group(1)), body)
    # in brief and signature: keep the words, drop the web classes
    body = re.sub(r'<p class="rs-inbrief"><span class="rs-inbrief-label">In brief</span> (.*?)</p>', r'<p class="inbrief"><span class="label">In brief.</span> \1</p>', body)
    body = body.replace('<p class="rs-signed">', '<p class="signed">')
    # the text: <div class="rs-verse"> and <div class="rs-passages"> become fenced divs; other wrapper lines go
    body = containers(body)
    # passage numbers become spans Pandoc can link to (#s3, #s4.3), set on the line above their text;
    # linkable headings become Markdown headings
    ids = []
    def number(m):
        ids.append(m.group(1))
        return "[%s]{.v #s%s}" % (m.group(2), m.group(1))
    body = re.sub(r'<a class="v" id="([^"]+)" href="#\1">(.*?)</a>  ?\n', lambda m: number(m) + "\n", body)
    body = re.sub(r'<a class="v" id="([^"]+)" href="#\1">(.*?)</a>', number, body)
    def heading(m):
        pid, inner = m.group(2), m.group(3)
        inner = re.sub(r'^<a href="#%s">(.*)</a>$' % re.escape(pid), r"\1", inner.strip())
        ids.append(pid)
        return "%s %s {#s%s}" % ("#" * int(m.group(1)), inner, pid)
    body = re.sub(r'(?m)^<h([23])\b[^>]*?\bid="([^"]+)"[^>]*>(.*)</h\1>$', heading, body)
    # a contents list of cases or chapters: raw HTML links are not moved between files by Pandoc, so the
    # list becomes Markdown links, and the collapsible wrapper goes
    body = re.sub(r'(?m)^<details class="koan-contents">\n<summary>(.*?)</summary>\n', r"**\1**\n", body)
    body = re.sub(r"(?m)^</details>\n", "", body)
    body = re.sub(r'(?m)^<ol class="koan-toc">\n', "", body)
    body = re.sub(r'(?m)^<li><a href="#([^"]+)">(.*?)</a></li>$', r"- [\2](#\1)", body)
    body = re.sub(r"(?m)^</ol>\n", "", body)
    # links to a passage of this edition (#3, /slug#3) go to its span in the book
    alt = "|".join(re.escape(i) for i in sorted(ids, key=len, reverse=True)) or "(?!)"
    body = re.sub(r'(\]\(|href=")(?:/%s)?#(%s)(?=[)"])' % (re.escape(slug), alt), r"\1#s\2", body)
    # download section -> where this lives online
    unit = meta.get("passageUnit") or ("stanza" if "::: verse" in body else "passage")
    example = ids[min(2, len(ids) - 1)] if ids else ""
    online = "This edition lives at <%s/%s>" % (SITE, slug)
    online += ", where each %s has its own link (for example <%s/%s#%s>).\n" % (unit, SITE, slug, example) if example else ".\n"
    body = re.sub(r"(?s)## Download\n.*?(?=\n\[\^|\Z)", "## Online\n\n" + online, body)
    body = re.sub(r"\]\(/(?!/)", "](%s/" % SITE, body)
    body = re.sub(r'href="/(?!/)', 'href="%s/' % SITE, body)
    return body


def metadata(slug, meta, day):
    return {
        "title": meta["title"],
        "creator": [{"role": "aut", "text": person(meta["author"])}],
        "contributor": [{"role": "trl", "text": "Translated by " + meta["translator"]}],
        "lang": "en-GB",
        "date": day,
        "rights": meta["licence"],
        "source": meta["source"],
        "subject": meta["tradition"],
        "publisher": "Sutras (%s)" % SITE,
        "identifier": "urn:uuid:" + str(uuid.uuid5(uuid.NAMESPACE_URL, SITE + "/" + slug)),
        "description": meta["description"],
    }


# The cover, in the manner of Fitzcarraldo Editions' covers: one flat colour, the author and the title,
# nothing else. Change these two to recolour every cover (the paper #ebe7e0 with ink #211e1b is the quiet
# alternative). The text's image is not on the cover: it is the frontispiece, with its credit (see titlepage).
COVER_GROUND, COVER_INK = "#c9502f", "#f4efe6"


def balanced(text, most):
    """Lines of at most `most` characters (a longer word gets a line to itself), as few as possible and as even
    as the words allow: 'ON THE / SHORTNESS / OF LIFE', not 'ON THE / SHORTNESS OF / LIFE'."""
    count = len(textwrap.wrap(text, most))
    for limit in range(-(-len(text) // count), most + 1):
        lines = textwrap.wrap(text, limit, break_long_words=False)
        if len(lines) <= count:
            return lines
    return textwrap.wrap(text, most, break_long_words=False)


def cover(meta):
    """A typographic cover: a name above, the title in spaced capitals below, centred, one colour. The name is
    the author's, or for an anonymous or traditional text the translator's, which also tells the two Diamond
    Sutras apart; a bracketed note on the title ("(Red Pine)") is left off."""
    width, height, size, track = 1600, 2400, 124, 0.12
    title = balanced(re.sub(r"\s*\(.*?\)", "", meta["title"]).upper(), 13)
    name = person(meta["author"])
    if re.match(r"(?i)anonymous|traditionally", name):
        name = "Translated by " + person(meta["translator"])
    y = 860
    out = ['<text x="800" y="%d" font-size="76" font-style="italic">%s</text>' % (y, escape(name))]
    y += 150 + size
    for line in title:
        out.append('<text x="800" y="%d" font-size="%d" letter-spacing="%.0f">%s</text>' % (y, size, size * track, escape(line)))
        y += size * 1.3
    return f"""<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" viewBox="0 0 {width} {height}">
<title>{escape(meta["title"])}</title>
<rect width="{width}" height="{height}" fill="{COVER_GROUND}"/>
<g font-family="Literata, Georgia, 'Times New Roman', serif" fill="{COVER_INK}" text-anchor="middle">
{"".join(out)}
</g>
</svg>
"""


def backlink(text):
    """Number each note in the list at the end of a chapter file, as a link back to its mark, so a reader that
    shows the list instead of pop-ups can match note to mark. Pandoc's EPUB 3 notes carry no number."""
    marks = dict(re.findall(r'<a href="#(fn\d+)" class="footnote-ref"[^>]*>([^<]+)</a>', text))
    def number(m):
        n = marks.get(m.group(2))
        return m.group(1) + ('<a href="#fnref%s" class="footnote-back" role="doc-backlink">%s.</a> ' % (m.group(2)[2:], n) if n else "")
    return re.sub(r'(<aside epub:type="footnote" role="doc-footnote" id="(fn\d+)">\s*<p>)', number, text)


def retitle(path):
    """Pandoc names each chapter file's <title> after the file (ch004.xhtml); give it the first heading instead.
    Also numbers the notes (backlink)."""
    with zipfile.ZipFile(path) as z:
        entries = [(info, z.read(info.filename)) for info in z.infolist()]
    with zipfile.ZipFile(path, "w") as z:
        for info, data in entries:
            if re.match(r"EPUB/text/ch\d+\.xhtml$", info.filename):
                text = data.decode("utf-8")
                m = re.search(r"(?s)<h[1-3][^>]*>(.*?)</h[1-3]>", text)
                if m:
                    title = html.unescape(re.sub(r"<[^>]+>", "", m.group(1))).strip()
                    text = re.sub(r"<title>[^<]*</title>", lambda _: "<title>%s</title>" % escape(title), text, count=1)
                data = backlink(text).encode("utf-8")
            z.writestr(info, data)


def titlepage(path, kicker, translator):
    """Finish Pandoc's title page as the site's head: the frontispiece (moved from the first chapter file) with
    its credit, then the label ("Zen · a poem"), the title, the author and the translator."""
    with zipfile.ZipFile(path) as z:
        entries = [(info, z.read(info.filename)) for info in z.infolist()]
    files = {info.filename: data.decode("utf-8") for info, data in entries if info.filename.endswith(".xhtml")}
    figure = None
    for name, text in files.items():
        m = re.search(r'(?s)\n?<figure>\s*<img [^>]*class="frontispiece".*?</figure>', text)
        if m and name.startswith("EPUB/text/ch"):
            figure = m.group(0).strip()
            files[name] = text[:m.start()] + text[m.end():]
            break
    name = "EPUB/text/title_page.xhtml"
    page = files[name]
    if figure:
        figure = figure.replace(' class="frontispiece"', "").replace("<figure>", '<figure class="frontispiece">', 1)
        page = page.replace('<section epub:type="titlepage" class="titlepage">',
                            '<section epub:type="titlepage" class="titlepage">\n' + figure, 1)
    if kicker:
        page = page.replace('<h1 class="title">', '<p class="kicker">%s</p>\n  <h1 class="title">' % escape(kicker), 1)
    page = re.sub(r'(<p class="aut">.*?</p>)', lambda m: m.group(1) + '\n  <p class="trl">Translated by %s</p>' % escape(translator), page, count=1)
    files[name] = page
    with zipfile.ZipFile(path, "w") as z:
        for info, data in entries:
            z.writestr(info, files[info.filename].encode("utf-8") if info.filename in files else data)


def build(slug):
    root_meta, body = read_edition(slug)
    seconds = source_time(slug)
    day = datetime.datetime.fromtimestamp(seconds, datetime.timezone.utc).date().isoformat()
    book = to_book(slug, root_meta, body)
    out = ROOT / "downloads" / (slug + ".epub")
    out.parent.mkdir(exist_ok=True)
    env = dict(os.environ, SOURCE_DATE_EPOCH=str(seconds))
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        (tmp / "book.md").write_text(book, encoding="utf-8")
        (tmp / "cover.svg").write_text(cover(root_meta), encoding="utf-8")
        (tmp / "metadata.yaml").write_text(yaml.safe_dump(metadata(slug, root_meta, day), allow_unicode=True, sort_keys=False), encoding="utf-8")
        level = chapter_level(body)
        cmd = ["pandoc", str(tmp / "book.md"), "-f", "markdown", "-t", "epub3", "-o", str(out),
               "--css", str(CSS), "--resource-path", str(ROOT), "--split-level=%d" % level, "--toc", "--toc-depth=3",
               "--metadata-file", str(tmp / "metadata.yaml"), "--epub-cover-image", str(tmp / "cover.svg")]
        subprocess.run(cmd, check=True, env=env)
    kicker = re.search(r'<span class="rs-kicker">(.*?)</span>', body)
    titlepage(out, html.unescape(kicker.group(1)) if kicker else None, person(root_meta["translator"]))
    retitle(out)
    print("wrote", out.relative_to(ROOT))
    return out


def validate(path):
    """Run epubcheck if it is installed; return False on errors."""
    if subprocess.run(["which", "epubcheck"], capture_output=True).returncode != 0:
        print("warning: epubcheck not installed; %s not checked" % path.name, file=sys.stderr)
        return True
    result = subprocess.run(["epubcheck", str(path)], capture_output=True, text=True)
    if result.returncode != 0:
        print(result.stdout + result.stderr, file=sys.stderr)
        print("epubcheck failed: %s" % path.name, file=sys.stderr)
        return False
    return True


def main(args):
    if args == ["--all"]:
        slugs = published_slugs()
    elif len(args) == 1 and not args[0].startswith("-"):
        slugs = [args[0]]
    else:
        sys.exit(__doc__)
    ok = True
    for slug in slugs:
        ok = validate(build(slug)) and ok
    if not ok:
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])
